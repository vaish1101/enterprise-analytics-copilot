{
  "name": "enterprise-analytics-copilot-ui",
  "private": true,
  "author": "Vaishnavi Iyer",
  "license": "UNLICENSED",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build && node scripts/copy-font-licenses.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "build:demo": "tsc --noEmit -p tsconfig.app.json && vite build --mode demo && node scripts/copy-font-licenses.mjs",
    "preview": "vite preview",
    "release:smoke": "node scripts/release-smoke.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "gsap": "3.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "playwright": "^1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
